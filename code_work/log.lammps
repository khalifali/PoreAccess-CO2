variable finalAtoms      equal atoms
variable finalSolidVol   equal c_solidVolume
variable finalBedHeight  equal c_zTop
variable finalBedVolume  equal v_pi*v_Rtube*v_Rtube*v_finalBedHeight
variable finalPacking    equal v_finalSolidVol/v_finalBedVolume
variable finalPorosity   equal 1.0-v_finalPacking
variable finalKE         equal ke
variable finalMaxSpeed   equal c_maxSpeed
variable finalMinBottom  equal c_zBottom

# Particle table: solid nodes and geometry used to reconstruct the pore space.
# Wall-contact columns are: contact flag, wall-force xyz, wall-contact-point xyz
# and particle radius, following fix wall/gran/region with the contacts keyword.
write_dump all custom ${outdir}/particles_final.dump      id type x y z radius mass vx vy vz omegax omegay omegaz fx fy fz      f_tubeWall[1] f_tubeWall[2] f_tubeWall[3] f_tubeWall[4]      f_tubeWall[5] f_tubeWall[6] f_tubeWall[7] f_tubeWall[8]      modify sort id
write_dump all custom co2_13x_seed_161123/particles_final.dump      id type x y z radius mass vx vy vz omegax omegay omegaz fx fy fz      f_tubeWall[1] f_tubeWall[2] f_tubeWall[3] f_tubeWall[4]      f_tubeWall[5] f_tubeWall[6] f_tubeWall[7] f_tubeWall[8]      modify sort id

# Interacting bead pairs.  The later Python workflow computes overlap and
# normalized gap directly from this distance and the saved radii.
compute pairIDs all property/local patom1 patom2 ptype1 ptype2 cutoff radius
compute pairState all pair/local dist dx dy dz force fx fy fz                   p1 p2 p3 p4 cutoff radius

dump contacts all local 1 ${outdir}/contacts_final.dump      index c_pairIDs[1] c_pairIDs[2] c_pairIDs[3] c_pairIDs[4]      c_pairState[1] c_pairState[2] c_pairState[3] c_pairState[4]      c_pairState[5] c_pairState[6] c_pairState[7] c_pairState[8]      c_pairState[9] c_pairState[10] c_pairState[11] c_pairState[12]
dump contacts all local 1 co2_13x_seed_161123/contacts_final.dump      index c_pairIDs[1] c_pairIDs[2] c_pairIDs[3] c_pairIDs[4]      c_pairState[1] c_pairState[2] c_pairState[3] c_pairState[4]      c_pairState[5] c_pairState[6] c_pairState[7] c_pairState[8]      c_pairState[9] c_pairState[10] c_pairState[11] c_pairState[12]
dump_modify contacts format line      "%d %.0f %.0f %.0f %.0f %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e %.12e"
dump_modify contacts first yes
run 1
